<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/images">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/infoConversor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textViewInfoPg"
                android:textColor="#0000FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pedirPulgadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/textViewHintPedirPg"
                android:inputType="numberDecimal"
                android:textAlignment="center" />

            <Button
                android:id="@+id/buttonInvertirPulg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/buttonInvertir" />

            <Button
                android:id="@+id/buttonConvertir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/buttonConvertir" />

            <EditText
                android:id="@+id/editResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/editTextHintResultado"
                android:inputType="numberDecimal"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/infoConversor2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textViewInfoM"
                android:textColor="#0000FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pedirCM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/textViewHintPedirCm"
                android:inputType="numberDecimal"
                android:textAlignment="center" />

            <Button
                android:id="@+id/buttonInvertirM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/buttonInvertir" />

            <Button
                android:id="@+id/buttonConvertirM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/buttonConvertir" />

            <EditText
                android:id="@+id/editResultadoM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/editTextHintResultado"
                android:inputType="numberDecimal"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/infoConversor3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textViewInfoY"
                android:textColor="#0000FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pedirY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/textViewHintPedirCm"
                android:inputType="numberDecimal"
                android:textAlignment="center" />

            <Button
                android:id="@+id/buttonInvertirY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/buttonInvertir" />

            <Button
                android:id="@+id/buttonConvertirY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/buttonConvertir" />

            <EditText
                android:id="@+id/editResultadoY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/editTextHintResultado"
                android:inputType="numberDecimal"
                android:textAlignment="center" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>